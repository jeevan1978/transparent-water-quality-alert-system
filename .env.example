# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=True

# Synthetic Data Simulation Settings
DATA_MODE=simulated
SIMULATION_INTERVAL_MINUTES=60
DEFAULT_MONITORING_STATIONS=Station-Alpha,Station-Beta,Station-Gamma

# Supabase PostgreSQL Configuration
# (Leave blank or unset to run in Local SQLite / In-Memory Mock Mode)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_DB_HOST=aws-0-region.pooler.supabase.com
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_DB_PORT=5432

# Alert Notification Webhook (Optional - e.g. Slack / Teams / Email webhook)
ALERT_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENTS=
